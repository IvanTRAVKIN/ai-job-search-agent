# Copy this file, name the copy .env and put your own key instead of sk-ant-...
ANTHROPIC_API_KEY=sk-ant-...
 
# Model and reasoning effort (EFFORT: low / medium / high).
#   claude-opus-5-5   + medium  ~ $0.12 per CV (best quality)
#   claude-sonnet-5-5 + low     ~ $0.04-0.05 per CV (good balance)
#   claude-haiku-5-5  + low     ~ $0.005 per CV (for tests, lower quality)
MODEL=claude-sonnet-5-5
EFFORT=medium
 
# CV language:
#   auto    - same as the job posting (French posting -> French CV, otherwise English)
#   English - always English
#   French  - always French
CV_LANGUAGE=auto
 
# Photo: zoom (100 = no zoom) and vertical center (0 = top).
# If the head is cut off, lower PHOTO_TOP; if too much is visible, raise PHOTO_ZOOM.
PHOTO_ZOOM=165
PHOTO_TOP=18
 
# Cover letter for each job (yes / no). Adds about $0.01-0.02.
COVER_LETTER=yes
 
# Fit check before making a CV: does the job match your rules in about_me.txt?
# (costs less than $0.002 per job). Jobs that don't fit are skipped without paying for a CV.
FILTER=yes
FILTER_MODEL=claude-haiku-5-5
# Minimum match score (0-100) needed to make a CV.
MIN_SCORE=50
 
# For find_jobs.py (the bot searches LinkedIn by itself):
# Browser: chrome or msedge
BROWSER=chrome
# Job titles to search, separated by ;
SEARCH_KEYWORDS=Business Analyst;Data Analyst;Pricing Analyst
# City
SEARCH_LOCATION=Paris, Île-de-France, France
# Only recent jobs: 24h, week or month
DATE_POSTED=week
# Level: 1 = internship, 2 = entry level, 3 = associate. Empty = any.
EXPERIENCE_LEVELS=2,3
# How many new CVs to make per run (the bot keeps going until it has made this many)
MAX_JOBS=5
# Maximum number of jobs to open per run (skipped and rejected jobs count too)
MAX_CHECKS=30
# How many LinkedIn result pages to read per search (25 jobs per page)
SEARCH_PAGES=3
# Words to exclude in the LinkedIn search (separated by ;). Empty = normal search like on the website
SEARCH_EXCLUDE=
# If the job TITLE contains one of these words, the bot doesn't even open it (separated by ;)
SKIP_TITLE_WORDS=senior;sénior;lead;head of;principal;manager;director;directeur;directrice;data engineer;data scientist;quant;développeur;developer;stage;stagiaire;intern;internship;alternance;alternant;apprenti
# Search with natural phrases, like you type in the LinkedIn search box (separated by ;).
# If set, SEARCH_KEYWORDS, SEARCH_LOCATION, DATE_POSTED and EXPERIENCE_LEVELS are ignored.
SEARCH_QUERIES=business analyst paris posted in the past week;entry-level business analyst paris posted in the past week;data analyst paris posted in the past week
# When new jobs in Paris run out, search the same phrases with "france" instead of "paris" (yes/no)
FRANCE_FALLBACK=yes
# Cover letter length (in words)
COVER_WORDS=350-450
# Job language: en = English only, fr = French only, any = all
JOB_LANGUAGE=any
# You can also choose the language when you run it: python find_jobs.py en  /  python find_jobs.py fr  /  python find_jobs.py any
# Your own phrases for each language (optional; if missing, SEARCH_QUERIES is used):
# SEARCH_QUERIES_EN=English business analyst paris posted in the past week;english paris
# SEARCH_QUERIES_FR=business analyst paris posted in the past week
# In en mode, don't open jobs with a French title (H/F, Chargé...). Default no: the language is checked from the description
SKIP_FRENCH_TITLES=no
# English mode (python find_jobs.py en): classic LinkedIn search with these words + English phrases in the description
# ("you will", "we are looking for"...), so LinkedIn shows mostly English postings.
# If set, it is used in en mode instead of SEARCH_QUERIES_EN.
SEARCH_KEYWORDS_EN=business analyst;data analyst;business developer;pricing analyst;market analyst
# Companies you don't want (separated by ;). The bot skips them without an AI check
EXCLUDE_COMPANIES=CompanyA;CompanyB
# Skip jobs that already have this many applicants or more ("people clicked apply" / "applicants"). 0 = don't check
MAX_APPLICANTS=90
